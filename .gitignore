node_modules/

# Env files (apenas o .example vai para o git)
observability/.env.observability
docker/.env.prod
docker/.env.infra
docker/.env.api
docker/.env.web
cloudflare/.env.cloudflare

# Certificados Cloudflare Origin CA (materializados pelo deploy.yml, nunca commitados)
docker/certs/

# Dados gerados pelos scripts de seed
# data/*.json

# Volumes Docker persistidos localmente
observability/grafana/data/
observability/loki/chunks/
observability/tempo/blocks/

# Structurizr: mantem o DSL e o tema versionados; ignora so o runtime/cache local
docker/structurizr/data/.structurizr/
docker/structurizr/data/workspace.json

# Terraform (state fica remoto no Terraform Cloud, nunca local)
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/crash.log
infra/terraform/**/*.tfvars
infra/terraform/**/*.tfvars.json
infra/terraform/**/override.tf
infra/terraform/**/override.tf.json

# graphify knowledge graph (regenerated locally by hooks)
graphify-out/

# local per-machine agent config (embeds absolute paths)
.claude/settings.json
.claude/settings.local.json
