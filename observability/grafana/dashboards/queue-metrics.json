{
  "title": "Oikos API — BullMQ Queues",
  "uid": "oikos-queues",
  "description": "BullMQ job queue depth, processing rate and worker utilization",
  "tags": ["oikos", "queues", "bullmq"],
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Taxa de Jobs Processados (job/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(oikos_messaging_process_duration_seconds_count[1m])) by (messaging_destination_name)",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "title": "Duração P95 de Processamento de Jobs (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(oikos_messaging_process_duration_seconds_bucket[5m])) by (le, messaging_destination_name)) * 1000",
          "legendFormat": "p95 {{messaging_destination_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "title": "Comandos Redis (ioredis spans)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(oikos_db_client_operation_duration_seconds_count{db_system=\"redis\"}[1m])) by (db_operation_name)",
          "legendFormat": "{{db_operation_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      }
    }
  ]
}
