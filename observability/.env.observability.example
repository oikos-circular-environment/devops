# Credenciais do Grafana (admin UI em localhost:3000)
GF_ADMIN_PASSWORD=admin

# Alertmanager — Slack (descomente para habilitar alertas)
# ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# k6 — endereço da API para os testes de carga
# Dev local (npm run dev): http://host.docker.internal:3333  ← padrão
# Produção (docker-compose.prod.yml): http://api:3333
K6_BASE_URL=http://host.docker.internal:3333
