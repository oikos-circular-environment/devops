# Credenciais do Grafana (admin UI em localhost:3000)
# Gere uma nova senha com: openssl rand -base64 32
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=troque-por-uma-senha-forte-gerada-localmente

