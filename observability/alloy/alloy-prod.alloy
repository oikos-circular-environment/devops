// Alloy consolidado — substitui otelcol (dev) + promtail (prod antigo) numa coisa só.
// Roda na A1.Flex, envia tudo pra Prometheus/Loki/Tempo na E2.1.Micro via IP privado da VCN.
// Variáveis de ambiente necessárias: PROMETHEUS_REMOTE_WRITE_URL, LOKI_URL, TEMPO_ENDPOINT.

// ── OTLP: recebe traces + métricas direto da aplicação (api) ───────────────
// api aponta OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
otelcol.receiver.otlp "app" {
	http {
		endpoint = "0.0.0.0:4318"
	}
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces  = [otelcol.processor.batch.app.input]
		metrics = [otelcol.processor.batch.app.input]
	}
}

otelcol.processor.batch "app" {
	output {
		traces  = [otelcol.exporter.otlp.tempo.input]
		metrics = [otelcol.exporter.prometheus.app.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = env("TEMPO_ENDPOINT") // ex: 10.x.x.x:4317
		tls {
			insecure = true // rede privada da VCN, sem TLS entre as duas VMs
		}
	}
}

otelcol.exporter.prometheus "app" {
	forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ── Métricas de infraestrutura (cAdvisor + node-exporter, na própria A1.Flex) ─
prometheus.scrape "cadvisor" {
	targets         = [{ __address__ = "cadvisor:8080" }]
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.scrape "node_exporter" {
	targets         = [{ __address__ = "node-exporter:9100" }]
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
	endpoint {
		url = env("PROMETHEUS_REMOTE_WRITE_URL") // ex: http://10.x.x.x:9090/api/v1/write
	}
}

// ── Logs (arquivo — Pino/pino-roll escreve em logs/server.log e logs/queries.log,
//    NÃO vai via OTLP; só traces/métricas usam OTLP) ─────────────────────────
local.file_match "oikos" {
	path_targets = [{ __path__ = "/var/log/oikos/*.log", job = "oikos-api" }]
}

loki.source.file "oikos" {
	targets    = local.file_match.oikos.targets
	forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
	endpoint {
		url = env("LOKI_URL") // ex: http://10.x.x.x:3100/loki/api/v1/push
	}
}
