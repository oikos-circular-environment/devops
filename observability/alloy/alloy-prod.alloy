// Alloy consolidado — substitui otelcol (dev). Roda na A1.Flex, envia tudo pra
// Prometheus/Loki/Tempo na E2.1.Micro via IP privado da VCN.
// Variáveis de ambiente necessárias: PROMETHEUS_REMOTE_WRITE_URL, LOKI_URL, TEMPO_ENDPOINT.
//
// Logs vão 100% via OTLP (pino-opentelemetry-transport no api) — sem arquivo, sem tail.
// Trade-off consciente: se o Alloy cair, logs gerados nessa janela se perdem (sem buffer em
// disco). Aceito por ora; revisitar se isso causar problema real em produção.
//
// Log de query nativo do Postgres avaliado e descartado (2026-07-03) — decisão
// consciente de usar o PRISMA_QUERY_LOG do api em vez disso (já correlaciona
// com traceId/spanId da requisição via OTLP, o que o log nativo não faria).

// ── OTLP: recebe traces + métricas + logs direto da aplicação (api) ────────
// api aponta OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
otelcol.receiver.otlp "app" {
	http {
		endpoint = "0.0.0.0:4318"
	}
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces  = [otelcol.processor.batch.app.input]
		metrics = [otelcol.processor.batch.app.input]
		logs    = [otelcol.processor.batch.app.input]
	}
}

otelcol.processor.batch "app" {
	output {
		traces  = [otelcol.exporter.otlp.tempo.input]
		metrics = [otelcol.exporter.prometheus.app.input]
		logs    = [otelcol.processor.attributes.loki_labels.input]
	}
}

// OTLP não converte atributos em labels do Loki automaticamente — precisa do hint
// `loki.resource.labels` explícito (ver docs do otelcol.exporter.loki).
otelcol.processor.attributes "loki_labels" {
	action {
		key    = "loki.resource.labels"
		action = "insert"
		value  = "service.name, deployment.environment.name"
	}

	output {
		logs = [otelcol.exporter.loki.app.input]
	}
}

otelcol.exporter.loki "app" {
	forward_to = [loki.write.monitoring.receiver]
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = sys.env("TEMPO_ENDPOINT") // ex: 10.x.x.x:4317
		tls {
			insecure = true // rede privada da VCN, sem TLS entre as duas VMs
		}
	}
}

otelcol.exporter.prometheus "app" {
	forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ── Métricas de infraestrutura (cAdvisor + node-exporter, na própria A1.Flex) ─
prometheus.scrape "cadvisor" {
	targets         = [{ __address__ = "cadvisor:8080" }]
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.scrape "node_exporter" {
	targets         = [{ __address__ = "node-exporter:9100" }]
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
	endpoint {
		url = sys.env("PROMETHEUS_REMOTE_WRITE_URL") // ex: http://10.x.x.x:9090/api/v1/write
	}
}

loki.write "monitoring" {
	endpoint {
		url = sys.env("LOKI_URL") // ex: http://10.x.x.x:3100/loki/api/v1/push
	}
}
