#cloud-config
package_update: true
package_upgrade: false

packages:
  - docker.io
  - docker-compose-v2

users:
  - default
  - name: deploy
    groups: [docker, sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      KbdInteractiveAuthentication no

runcmd:
  - systemctl enable --now docker
  - systemctl restart ssh
  - mkdir -p /opt/oikos/docker/certs /opt/oikos/nginx /opt/oikos/observability /opt/oikos/scripts
  - chown -R deploy:deploy /opt/oikos
  - touch /opt/oikos/docker/.env.infra /opt/oikos/docker/.env.api /opt/oikos/docker/.env.web
  - chown deploy:deploy /opt/oikos/docker/.env.infra /opt/oikos/docker/.env.api /opt/oikos/docker/.env.web
  - chmod 600 /opt/oikos/docker/.env.infra /opt/oikos/docker/.env.api /opt/oikos/docker/.env.web
  - |
    if [ "${swap_size_gb}" -gt 0 ]; then
      fallocate -l ${swap_size_gb}G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
      echo 'vm.swappiness=10' >> /etc/sysctl.conf
      sysctl -p
    fi
