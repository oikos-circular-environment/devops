[Unit]
Description=Backup diario do Postgres e Redis pro Oracle Object Storage (T8)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/oikos
# Pre-requisito (instalacao manual da OCI CLI) - ver docs/docker-infra.md#7
ExecStart=/opt/oikos/scripts/backup-postgres.sh
ExecStart=/opt/oikos/scripts/backup-redis.sh
