# Migrado de oikos/api/Dockerfile.prod (ticket 01/06). Build context: raiz do repo oikos/api.

# ---- Stage 1: Builder ----
FROM node:24-alpine AS builder
WORKDIR /app

# O lockfile foi gerado com npm v11; garantir versão consistente no container
RUN npm install -g npm@11

COPY package*.json ./
COPY prisma/*.prisma ./prisma/
COPY prisma/migrations ./prisma/migrations
COPY prisma.config.ts ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/
RUN npx prisma generate && npm run build

# ---- Stage 2: Production ----
FROM node:24-alpine AS production
WORKDIR /app

ENV NODE_ENV=production

RUN npm install -g npm@11

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

# prisma CLI é devDep, mas necessária pro `prisma migrate deploy` do deploy.yml (ticket 09)
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma
COPY --from=builder /app/node_modules/.bin/prisma ./node_modules/.bin/prisma

# Aplicação compilada
COPY --from=builder /app/dist ./dist

# Schema, migrations e config do Prisma para `prisma migrate deploy`
COPY --from=builder /app/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder /app/prisma/enums.prisma ./prisma/enums.prisma
COPY --from=builder /app/prisma/migrations ./prisma/migrations
COPY prisma.config.ts ./

# Logs (logger.ts, pino-opentelemetry-transport) vão via OTLP pro Alloy — sem arquivo,
# sem volume de logs (ver observability/alloy/alloy-prod.alloy).

EXPOSE 3333

# Migration NÃO roda aqui — é um passo separado do deploy.yml (docker compose run --rm api
# npx prisma migrate deploy), pra não derrubar o container antigo antes de validar a migration.
CMD ["node", "--import", "./dist/lib/otel.js", "dist/server.js"]
