# Exemplo consolidado das variáveis de ambiente de produção (gitignored).
# Em produção real elas são fragmentadas em .env.infra, .env.api e .env.web
# e renderizadas pelos workflows deploy-stack.yml, deploy-api.yml e
# deploy-web.yml a partir dos GitHub Environments — nunca commitadas.

# ── Versões das imagens (preenchidas pelo deploy.yml a partir do repository_dispatch) ──
API_VERSION=latest
WEB_VERSION=latest

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=oikos

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── api — variáveis não cobertas pelos serviços acima ───────────────────────
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
QUORUM_JOB_DELAY_MS=86400000
ACCOUNT_DELETION_DELAY_MS=7776000000
WORKER_CONCURRENCY=5
BETTER_AUTH_SECRET=

# ── api — provedor de e-mail (api/src/env/index.ts) ─────────────────────────
# EMAIL_PROVIDER vem de vars.EMAIL_PROVIDER (repositório), nunca hardcoded no
# workflow - trocar de provedor é só mudar a var, sem editar deploy-api.yml.
# Valores possíveis: console | in-memory | resend
EMAIL_PROVIDER=
# RESEND_API_KEY e RESEND_FROM_EMAIL só são obrigatórios quando EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── web — URL publica da api, lida em build-time (NEXT_PUBLIC_*, inlined no
# bundle do browser) e em runtime (server-side) pelo mesmo container ───────
NEXT_PUBLIC_API_URL=https://api.oikos.company

# ── Client-key (mobile#34) — segredos fixos, api/web/mobile#34 ─────────────
# CLIENT_KEY_MOBILE e CLIENT_KEY_WEB sao lidos pelo container api.
# CLIENT_API_KEY (mesmo valor de CLIENT_KEY_WEB) e lido pelo container web em
# runtime; NEXT_PUBLIC_CLIENT_API_KEY (mesmo valor, terceira copia) e lido em
# build-time pelo bundle do browser - as tres precisam ficar em sincronia
# numa rotacao. O valor de CLIENT_KEY_MOBILE tambem precisa estar no EAS
# environment de producao do mobile (EXPO_PUBLIC_CLIENT_API_KEY) - fora deste repo.
CLIENT_KEY_MOBILE=
CLIENT_KEY_WEB=
CLIENT_KEY_ENFORCE=true
CLIENT_API_KEY=
NEXT_PUBLIC_CLIENT_API_KEY=

# ── Turnstile (web#39) — captcha do formulario de Suporte, so o container web le ──
# Valores do widget provisionado no Terraform (cloudflare_turnstile_widget.support_form):
# terraform output turnstile_sitekey / terraform output -raw turnstile_secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── api — seeds de conta de teste (Google/Apple) ────────────────────────────
# NAO fazem parte do deploy.yml de proposito - sao opcionais no schema de env
# do api (GOOGLE_ACCOUNT_EMAIL/PASSWORD, APPLE_ACCOUNT_EMAIL/PASSWORD) e o
# seed que os usa (prisma/seeds/google-account.seed.ts, apple-account.seed.ts)
# e rodado manualmente, separado do deploy - mesma logica do seed de usuarios
# fake (prisma/seeds/users.seed.ts), que nunca deve subir pra producao via CI.

# ── Observabilidade — IP privado da VM E2.1.Micro (saída do terraform apply, T4) ──
PROMETHEUS_REMOTE_WRITE_URL=http://<IP-PRIVADO-E2.1.MICRO>:9090/api/v1/write
LOKI_URL=http://<IP-PRIVADO-E2.1.MICRO>:3100/loki/api/v1/push
TEMPO_ENDPOINT=<IP-PRIVADO-E2.1.MICRO>:4317
