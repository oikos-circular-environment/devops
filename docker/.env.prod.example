# Preencher e salvar como .env.prod (gitignored). Em produção real, esse arquivo é
# renderizado pelo deploy.yml (T9) a partir dos GitHub Secrets — nunca commitado.

# ── Versões das imagens (preenchidas pelo deploy.yml a partir do repository_dispatch) ──
API_VERSION=latest
WEB_VERSION=latest

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=oikos

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── api — variáveis não cobertas pelos serviços acima ───────────────────────
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
QUORUM_JOB_DELAY_MS=86400000
ACCOUNT_DELETION_DELAY_MS=7776000000
WORKER_CONCURRENCY=5

# ── Client-key (mobile#34) — segredos fixos, api/web/mobile#34 ─────────────
# CLIENT_KEY_MOBILE e CLIENT_KEY_WEB sao lidos pelo container api.
# CLIENT_API_KEY (mesmo valor de CLIENT_KEY_WEB) e lido pelo container web.
# O valor de CLIENT_KEY_MOBILE tambem precisa estar no EAS environment de
# producao do mobile (EXPO_PUBLIC_CLIENT_API_KEY) - fora deste repo.
CLIENT_KEY_MOBILE=
CLIENT_KEY_WEB=
CLIENT_KEY_ENFORCE=true
CLIENT_API_KEY=

# ── Turnstile (web#39) — captcha do formulario de Suporte, so o container web le ──
# Valores do widget provisionado no Terraform (cloudflare_turnstile_widget.support_form):
# terraform output turnstile_sitekey / terraform output -raw turnstile_secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── api — seeds de conta de teste (Google/Apple) ────────────────────────────
# NAO fazem parte do deploy.yml de proposito - sao opcionais no schema de env
# do api (GOOGLE_ACCOUNT_EMAIL/PASSWORD, APPLE_ACCOUNT_EMAIL/PASSWORD) e o
# seed que os usa (prisma/seeds/google-account.seed.ts, apple-account.seed.ts)
# e rodado manualmente, separado do deploy - mesma logica do seed de usuarios
# fake (prisma/seeds/users.seed.ts), que nunca deve subir pra producao via CI.

# ── Observabilidade — IP privado da VM E2.1.Micro (saída do terraform apply, T4) ──
PROMETHEUS_REMOTE_WRITE_URL=http://<IP-PRIVADO-E2.1.MICRO>:9090/api/v1/write
LOKI_URL=http://<IP-PRIVADO-E2.1.MICRO>:3100/loki/api/v1/push
TEMPO_ENDPOINT=<IP-PRIVADO-E2.1.MICRO>:4317
